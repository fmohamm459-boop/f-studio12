# Database configuration (PostgreSQL)
# When using AI Studio Cloud SQL, DATABASE_URL will be provided.
# If not provided, an in-memory mock database is used automatically.
DATABASE_URL=
DIRECT_URL=

# NextAuth / Auth.js configuration
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Cloudinary media management (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
